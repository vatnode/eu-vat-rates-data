  "coverage": {
    "from": "1967-07-03",
    "tedb_from": "2017-01-01"
  },
  "sources": {
    "ec-taxud-booklet-2021-06": {
      "name": "European Commission, DG TAXUD — \"VAT rates applied in the Member States of the European Union\", section VIII \"The evolution of VAT rates applicable in the Member States\"",
      "edition": "2021-06",
      "url": "https://taxation-customs.ec.europa.eu/system/files/2021-06/vat_rates_en.pdf",
      "note": "Publication discontinued in favour of TEDB. Transcribed once and frozen; not regenerated automatically."
    },
    "tedb": {
      "name": "European Commission — Taxes in Europe Database (TEDB)",
      "url": "https://ec.europa.eu/taxation_customs/tedb/",
      "note": "Queried via the VatRetrievalService SOAP endpoint. Returns no data before 2016-01-01."
    },
    "de-zweites-corona-steuerhilfegesetz-2020": {
      "name": "Zweites Gesetz zur Umsetzung steuerlicher Hilfsmaßnahmen zur Bewältigung der Corona-Krise (Zweites Corona-Steuerhilfegesetz), Artikel 3, amending § 12 UStG",
      "url": "https://www.bgbl.de/xaver/bgbl/start.xav?startbk=Bundesanzeiger_BGBl&jumpTo=bgbl120s1512.pdf",
      "note": "Germany cut the standard rate from 19% to 16% for 1 July to 31 December 2020. Neither TEDB nor the archived TAXUD booklet records this change."
    },
    "ee-rahandusministeerium-kaibemaksu-ajalugu": {
      "name": "Rahandusministeerium (Estonian Ministry of Finance), \"Käibemaksu ajalugu\" (History of VAT), compiled January 2006",
      "url": "https://www.fin.ee/sites/default/files/documents/2020-10/kaibemaksu_ajalugu_04_01_05%20(1).doc",
      "note": "The booklet dates Estonia's early rates by year only and gets both wrong: it has 10% from 1991 and 18% from 1993. The Ministry of Finance states the rate was initially 7%, became 10% in 1992, and rose to 18% from 20 June 1992 by decree no. 035 of the Currency Reform Committee — the same day as the kroon currency reform. Riigi Teataja carries that decree, dated 19 June 1992, under the title \"Maksumäärade muutmisest\". VAT itself took effect on 10 January 1991 under a 1990 government regulation; the 10% rate is dated to the entry into force of the Value Added Tax Act adopted on 16 October 1991."
    }
  },
